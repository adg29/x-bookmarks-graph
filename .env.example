# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Neo4j -------------------------------------------------------------------
# Local Docker (primary local path, see README):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
# Neo4j Aura (deployed / hosted): the URI scheme differs — it must be neo4j+s://
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=the-password-aura-showed-you-once
# NEO4J_DATABASE=neo4j

# --- Explorer gate -----------------------------------------------------------
# Shared passphrase for the private explorer. Unset in production = locked, not open.
# Locally it falls back to "dev-local-access" if you leave this out.
APP_ACCESS_SECRET=replace-me-with-a-long-random-string

# --- Ingest ------------------------------------------------------------------
# Bearer token the X Bookmarks agent presents to POST /api/ingest.
# Generate one: openssl rand -hex 32
INGEST_TOKEN=replace-me-with-a-long-random-string
